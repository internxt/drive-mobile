  "scripts": {
    "prepare": "husky install",
    "postinstall": "patch-package",
    "start": "expo start --dev-client",
    "android": "expo run:android --variant callbackTiramisuDebug",
    "ios": "expo run:ios",
    "link": "react-native link",
    "eject": "expo eject",
    "check-ts": "tsc --noEmit",
    "lint": "yarn run check-ts && eslint src --ext .tsx,.ts",
    "prepare-env": "node ./env/prepare-env-files.js",
    "lint:fix": "yarn lint --fix",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:e2e:build:android.debug": "detox build -c android.debug",
    "test:e2e:build:android.release": "detox build -c android.release",
    "test:e2e:build:ios.debug": "detox build -c ios.debug",
    "test:e2e:build:ios.release": "detox build -c ios.release",
    "test:e2e:test:android.debug": "detox test -c android.debug",
    "test:e2e:test:android.release": "detox test -c android.release",
    "test:e2e:test:ios.debug": "detox test -c ios.debug",
    "test:e2e:test:ios.release": "detox test -c ios.release",
    "tailwind:dev": "concurrently \"tailwindcss --input ./src/styles/input.css --output ./src/styles/tailwind.css --no-autoprefixer --watch\" \"tailwind-rn --watch  -i ./src/styles/tailwind.css -o ./src/styles/tailwind.json\"",
    "tailwind:build": "tailwindcss --input ./src/styles/input.css --output ./src/styles/tailwind.css --no-autoprefixer && tailwind-rn -i ./src/styles/tailwind.css -o ./src/styles/tailwind.json"
  },
